# Copy this file to .env and set the values for your environment.
# Values already set in the process environment override this file.

APP_NAME=register-api
APP_ENV=development

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# debug | info | warn | error
LOG_LEVEL=info

# MySQL database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=register_app
DB_PASSWORD=
DB_NAME=register
DB_CHARSET=utf8mb4
MYSQL_ROOT_PASSWORD=

# Database authentication bootstrap. Set both only for the first startup.
# Once the first admin is created, remove these values from deployment config.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Cryptographic services
NODE_ID=local-node
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit
VAULT_NID_ENCRYPTION_KEY=
VAULT_NID_HMAC_KEY=
