# Copy this file to .env and set values for your environment.
# Values in the process environment override values in .env.

APP_NAME=register-api
APP_ENV=development
DEV_HEADER_AUTH=true

SERVER_HOST=127.0.0.1
SERVER_PORT=9090
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Use a distinct least-privilege MariaDB account for every pool.
# `tls=true` is suitable only for local development; production must use
# verified TLS settings and client certificates.
DB_DSN_IDENTITY=identity:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_DSN_HEALTH=health:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_DSN_ELECTORAL=electoral:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_DSN_GRANTS=grants:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_DSN_POLICE=police:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_DSN_AUDIT=audit:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_DSN_AUTHZ=authz:change-me@tcp(127.0.0.1:3306)/register?tls=true

# Migration runner uses the elevated migration account separately.
DB_DSN_MIGRATE=migrator:change-me@tcp(127.0.0.1:3306)/register?tls=true
DB_ACCOUNT_HOST=10.%

NODE_ID=local-node

# Development OIDC auth is replaced by X-Dev-Official-ID lookups.
OIDC_ISSUER=
OIDC_AUDIENCE=register-api
OIDC_JWKS_URL=

# Vault Transit keys; values are secrets and must not be committed.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit
VAULT_NID_ENCRYPTION_KEY=nid-encryption
VAULT_NID_HMAC_KEY=nid-hmac

# Required in production. TLS_CLIENT_CA enables mutual TLS client validation.
TLS_CERT=
TLS_KEY=
TLS_CLIENT_CA=
