# Copy to your shell or export these values before running.
# No dotenv dependency is used; unset variables fall back to the defaults below.

APP_NAME=register-api
APP_ENV=development

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# debug | info | warn | error
LOG_LEVEL=info
